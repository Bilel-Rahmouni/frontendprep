# Production site URL (no trailing slash) — used for canonical, OG, sitemap
VITE_SITE_URL=https://frontendprep.site

# Google AdSense display unit slot IDs (create in AdSense → Ads → By ad unit)
# Ads load only after the user Accepts the cookie consent banner.
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_GUIDE=
VITE_ADSENSE_SLOT_PREP=

# Mobile app store links (home page CTA). Play defaults to package com.indigenoustech.frontendprep
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=
