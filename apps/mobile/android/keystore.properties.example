# Copy to android/keystore.properties (gitignored). Never commit real passwords.
# Store file lives in android/app/ (relative path below).

MYAPP_UPLOAD_STORE_FILE=dozone-upload-key.jks
MYAPP_UPLOAD_KEY_ALIAS=dozone-key
MYAPP_UPLOAD_STORE_PASSWORD=YOUR_STORE_PASSWORD
MYAPP_UPLOAD_KEY_PASSWORD=YOUR_KEY_PASSWORD
